local function updateUI()
	local keyName = currentKey.Name
	pickaxeLabel.Text = "Pickaxe: " .. currentPickaxe

	if spamming then
		digBtn.Text = isMobile and "Dig Mouse: ON" or ("DIGGING  [" .. keyName .. "]")
		digBtn.BackgroundColor3 = currentTheme.Accent
		status.Text = "Status: Digging"
		status.TextColor3 = currentTheme.Light
	else
		digBtn.Text = isMobile and "Dig Mouse: OFF" or ("Dig: OFF  [" .. keyName .. "]")
		digBtn.BackgroundColor3 = currentTheme.Dark
		status.Text = "Status: Idle"
		status.TextColor3 = Color3.fromRGB(180, 160, 200)
	end

	if promptEnabled then
		pickupStatus.Text = "Quick Pickup: ON"
		pickupStatus.TextColor3 = Color3.fromRGB(100, 255, 140)
	else
		pickupStatus.Text = "Quick Pickup: OFF"
		pickupStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
	end

	if buttonsLocked then
		lockBtn.Text = "Lock Buttons: ON"
		lockBtn.BackgroundColor3 = currentTheme.Accent
	else
		lockBtn.Text = "Lock Buttons: OFF"
		lockBtn.BackgroundColor3 = currentTheme.Dark
	end

	if isMobile then
		if promptEnabled then
			pickupBtn.Text = "Pickup\nON"
			pickupBtn.BackgroundColor3 = currentTheme.Accent
		else
			pickupBtn.Text = "Pickup\nOFF"
			pickupBtn.BackgroundColor3 = currentTheme.Dark
		end

		if mineFrontEnabled then
			mineFrontBtn.Text = "Mine\nON"
			mineFrontBtn.BackgroundColor3 = currentTheme.Accent
		else
			mineFrontBtn.Text = "Mine\nOFF"
			mineFrontBtn.BackgroundColor3 = currentTheme.Dark
		end
	end

	promptKeyBtn.Text = "Pickup Key: " .. promptKey.Name
end

-- ===================== MAIN WINDOW DRAGGING =====================
local mainDragging = false
local mainDragStart, mainStartPos, mainDragTouch

titleBar.InputBegan:Connect(function(input)
	if isMobile and buttonsLocked then return end

	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		mainDragging = true
		mainDragStart = input.Position
		mainStartPos = main.Position
		mainDragTouch = input
	end
end)

titleBar.InputEnded:Connect(function(input)
	if input == mainDragTouch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		mainDragging = false
		mainDragTouch = nil
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == mainDragTouch then
		mainDragging = false
		mainDragTouch = nil
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not mainDragging then return end

	if input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - mainDragStart
		main.Position = UDim2.new(mainStartPos.X.Scale, mainStartPos.X.Offset + delta.X, mainStartPos.Y.Scale, mainStartPos.Y.Offset + delta.Y)
	end

	if input.UserInputType == Enum.UserInputType.Touch and input == mainDragTouch then
		local delta = input.Position - mainDragStart
		main.Position = UDim2.new(mainStartPos.X.Scale, mainStartPos.X.Offset + delta.X, mainStartPos.Y.Scale, mainStartPos.Y.Offset + delta.Y)
	end
end)

