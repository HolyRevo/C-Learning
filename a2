-- ===================== BOULDER REVEAL (Fixed for mountain resets) =====================
task.spawn(function()
	while true do
		local mountain = Workspace:FindFirstChild("MountainDecorations")
		local boulders = mountain and mountain:FindFirstChild("Boulders")

		if boulders then
			for _, boulder in pairs(boulders:GetChildren()) do
				for _, part in pairs(boulder:GetChildren()) do
					if part:IsA("MeshPart") then
						part.Transparency = 0
					end
				end
			end
		end

		task.wait(3)
	end
end)

-- ===================== PROMPT SYSTEM =====================
local function spamPrompts()
	local character = player.Character
	if not character then return end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	for _, prompt in pairs(Workspace:GetDescendants()) do
		if prompt:IsA("ProximityPrompt") and prompt.Enabled then
			local success, pos = pcall(function()
				return prompt.Parent.Position
			end)
			if success and (pos - root.Position).Magnitude <= PROMPT_RANGE then
				pcall(fireproximityprompt, prompt)
			end
		end
	end
end

task.spawn(function()
	while true do
		if promptEnabled then
			spamPrompts()
		end
		task.wait(PROMPT_DELAY)
	end
end)

-- ===================== SHARED FUNCTIONS =====================
local function getMouseWorldPosition()
	local unitRay = camera:ScreenPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {player.Character}

	local result = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 2000, params)
	if result then return result.Position end
	return unitRay.Origin + unitRay.Direction * 40
end

local function getFrontPosition()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		return root.Position + (camera.CFrame.LookVector * 9) + Vector3.new(0, 1.2, 0)
	end
	return camera.CFrame.Position + camera.CFrame.LookVector * 11
end

local function startDig(useFront)
	if digConnection then return end
	digConnection = RunService.Heartbeat:Connect(function()
		if not spamming then return end
		local pos = useFront and getFrontPosition() or getMouseWorldPosition()
		DigRequest:FireServer(currentPickaxe, pos)
		task.wait(SPAM_DELAY)
	end)
end

local function stopDig()
	if digConnection then
		digConnection:Disconnect()
		digConnection = nil
	end
end

local function toggleDig(useFront)
	spamming = not spamming
	mineFrontEnabled = useFront and spamming or false
	if spamming then
		startDig(useFront)
	else
		stopDig()
	end
end

local function togglePickup()
	promptEnabled = not promptEnabled
end

local function switchPickaxe()
	currentPickaxeIndex = currentPickaxeIndex % #pickaxes + 1
	currentPickaxe = pickaxes[currentPickaxeIndex]
end

-- ===================== FLOATING BUTTON (Fixed Dragging) =====================
local function createFloatingButton(text, position, color)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 52, 0, 52)
	btn.Position = position
	btn.BackgroundColor3 = color
	btn.Text = text
	btn.Font = Enum.Font.GothamBlack
	btn.TextSize = 18
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextWrapped = true
	btn.AutoButtonColor = false

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Thickness = 1.4
	stroke.Transparency = 0.25
	stroke.Parent = btn

	local dragging = false
	local dragStart = nil
	local startPos = nil
	local dragTouch = nil

	btn.InputBegan:Connect(function(input)
		-- Only lock on mobile
		if isMobile and buttonsLocked then return end

		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = btn.Position
			dragTouch = input
		end
	end)

	btn.InputEnded:Connect(function(input)
		if input == dragTouch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			dragTouch = nil
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input == dragTouch then
			dragging = false
			dragTouch = nil
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end

		-- PC mouse movement
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end

		-- Mobile: only follow the same touch
		if input.UserInputType == Enum.UserInputType.Touch and input == dragTouch then
			local delta = input.Position - dragStart
			btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)

	return btn
end

